<section id="book-a-table" class="book-a-table section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Rezervasyon Yap</h2>
        <p><span>Muhteşem Planınızı</span> <span class="description-title">Oluşturun<br></span></p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row g-0" data-aos="fade-up" data-aos-delay="100">

            <div class="col-lg-4 reservation-img" style="background-image: url(/yummy-red-1.0.0/assets/img/reservation.jpg);"></div>

            <div class="col-lg-8 d-flex align-items-center reservation-form-bg" data-aos="fade-up" data-aos-delay="200">
                <!-- Hatalı kutu görünümünü silip tam genişlik (w-100) ve temiz bir padding (p-5) verdik -->
                <form asp-controller="Reservation" asp-action="BookTable" method="post" class="w-100 p-5">
                    <div class="row gy-4">
                        <div class="col-lg-4 col-md-6">
                            <input type="text" name="NameSurname" class="form-control" id="name" placeholder="İsminiz" required="">
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <input type="email" class="form-control" name="Email" id="email" placeholder="E-Posta Adresiniz" required="">
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <input type="text" class="form-control" name="PhoneNumber" id="phone" placeholder="Telefon Numaranız" required="">
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <input type="date" name="ReservationDate" class="form-control" id="date" placeholder="Tarih" required="">
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <input type="time" class="form-control" name="ReservationTime" id="time" placeholder="Saat" required="">
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <input type="number" class="form-control" name="CountofPeople" id="people" placeholder="Kişi Sayısı" required="">
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <textarea class="form-control" name="Message" rows="5" placeholder="Mesajınız"></textarea>
                    </div>

                    <!-- Butonu estetik bir şekilde ortaladık -->
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-danger rounded-pill px-5 py-2">Rezervasyon Yap</button>
                    </div>
                </form>
            </div><!-- End Reservation Form -->

        </div>

    </div>
</section>

<!-- Rezervasyon Başarılı Pop-up Kontrolü -->
@if (TempData["ReservationSuccess"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                title: 'Rezervasyon Alındı!',
                text: '@Html.Raw(TempData["ReservationSuccess"])',
                icon: 'success',
                confirmButtonText: 'Harika',
                confirmButtonColor: '#ce1212',
                timer: 2500,
                timerProgressBar: true
            });
        });
    </script>
}