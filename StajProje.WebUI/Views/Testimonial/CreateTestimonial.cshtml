@model CreateTestimonialDto

@{
    ViewData["Title"] = "CreateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Müşteri Yorumu Ekleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <label asp-for="NameSurname">İsim Soyisim</label>
                                <input type="text" asp-for="NameSurname" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Title">Ünvan</label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Comment">Yorum</label>
                                <textarea asp-for="Comment" rows="5" class="form-control"></textarea>
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Resim URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" />
                            </div>
                            <button class="btn btn-success">Ekle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>