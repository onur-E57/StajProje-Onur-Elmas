@model GetByIdMessageDto

@{
    ViewData["Title"] = "UpdateMessage";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Mesaj Güncelleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <input type="hidden" asp-for="MessageId" />
                            <div class="form-group">
                                <label asp-for="NameSurname">İsim Soyisim</label>
                                <input type="text" asp-for="NameSurname" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Email">E-Posta</label>
                                <input type="email" asp-for="Email" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Subject">Konu</label>
                                <input type="text" asp-for="Subject" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="MessageDetails">Açıklama</label>
                                <input type="text" asp-for="MessageDetails" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="SendDate">Gönderilme Tarihi</label>
                                <input type="date" asp-for="SendDate" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="IsRead">Okunma Durumu</label>
                                <input type="checkbox" asp-for="IsRead" class="form-control" />
                            </div>
                            
                            <button class="btn btn-success">Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>