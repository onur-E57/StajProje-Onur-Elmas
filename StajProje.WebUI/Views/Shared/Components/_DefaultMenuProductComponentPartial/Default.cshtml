@model List<ResultProductDto>

<style>
    .menu-item .menu-img {
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 10px;
    }
</style>

<div class="tab-content" data-aos="fade-up" data-aos-delay="200">

    <!-- 1. TÜM ÜRÜNLER SEKMESİ (#menu-starters) -->
    <div class="tab-pane fade active show" id="menu-starters">
        <div class="tab-header text-center">
            <p>Menü</p>
            <h3>Tüm Lezzetler</h3>
        </div>

        <div class="row gy-5">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 menu-item">
                    <a href="@item.ImageUrl" class="glightbox">
                        <img src="@item.ImageUrl" class="menu-img img-fluid" alt="">
                    </a>
                    <h4>@item.ProductName</h4>
                    <p class="ingredients">
                        @item.ProductDescription
                    </p>
                    <p class="price">
                        @item.ProductPrice ₺
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- 2. KATEGORİLERE GÖRE DİNAMİK SEKMELER -->
    @* Gelen tüm ürün listesini Component içinde CategoryId'ye göre parçalıyoruz *@
    @foreach (var group in Model.GroupBy(x => x.CategoryId))
    {
        <!-- Üstteki kategori butonlarının (data-bs-target) arayacağı ID'leri üretiyoruz -->
        <div class="tab-pane fade" id="menu-@group.Key">
            <div class="tab-header text-center">
                <p>Menü</p>
                <h3>Lezzetlerimiz</h3>
            </div>

            <div class="row gy-5">
                @foreach (var item in group)
                {
                    <div class="col-lg-4 menu-item">
                        <a href="@item.ImageUrl" class="glightbox">
                            <img src="@item.ImageUrl" class="menu-img img-fluid" alt="">
                        </a>
                        <h4>@item.ProductName</h4>
                        <p class="ingredients">
                            @item.ProductDescription
                        </p>
                        <p class="price">
                            @item.ProductPrice ₺
                        </p>
                    </div>
                }
            </div>
        </div>
    }

</div>