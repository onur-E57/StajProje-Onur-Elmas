@model List<ResultContactDto>

@{
    var item = Model.FirstOrDefault();
}

<section id="contact" class="contact section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>İletişim</h2>
        <p><span>Destek mi Lazım?</span> <span class="description-title">Bize Ulaşın</span></p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="mb-5">
            <iframe style="width: 100%; height: 400px;" src="@item.MapLocation" frameborder="0" allowfullscreen=""></iframe>
        </div><!-- End Google Maps -->

        <div class="row gy-4">

            <div class="col-md-6">
                <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="200">
                    <i class="icon bi bi-geo-alt flex-shrink-0"></i>
                    <div>
                        <h3>Adres</h3>
                        <p>@item.Address</p>
                    </div>
                </div>
            </div><!-- End Info Item -->

            <div class="col-md-6">
                <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="300">
                    <i class="icon bi bi-telephone flex-shrink-0"></i>
                    <div>
                        <h3>Bizi Arayın</h3>
                        <p>@item.Phone</p>
                    </div>
                </div>
            </div><!-- End Info Item -->

            <div class="col-md-6">
                <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="400">
                    <i class="icon bi bi-envelope flex-shrink-0"></i>
                    <div>
                        <h3>Bize E-Posta Gönderin</h3>
                        <p>@item.Email</p>
                    </div>
                </div>
            </div><!-- End Info Item -->

            <div class="col-md-6">
                <div class="info-item d-flex align-items-center" data-aos="fade-up" data-aos-delay="500">
                    <i class="icon bi bi-clock flex-shrink-0"></i>
                    <div>
                        <h3>Açılış Saatleri</h3>
                        <p><strong>@item.OpenHours</strong></p>
                    </div>
                </div>
            </div><!-- End Info Item -->

            <form asp-controller="Default" asp-action="SendMessage" method="post" class="mt-4 p-4 border rounded shadow-sm bg-white">
                <div class="row gy-4">

                    <div class="col-md-6">
                        <input type="text" name="NameSurname" class="form-control" placeholder="İsminiz" required="">
                    </div>

                    <div class="col-md-6 ">
                        <input type="email" class="form-control" name="Email" placeholder="E-Posta Adresiniz" required="">
                    </div>

                    <div class="col-md-12">
                        <input type="text" class="form-control" name="Subject" placeholder="Konu" required="">
                    </div>

                    <div class="col-md-12">
                        <textarea class="form-control" name="MessageDetails" rows="6" placeholder="Mesaj" required=""></textarea>
                    </div>

                    <div class="col-md-12 text-center mt-3">
                        <button type="submit" class="btn btn-danger rounded-pill px-5 py-2">Mesajı Gönder</button>
                    </div>

                </div>
            </form>

        </div>
    </div>
</section>