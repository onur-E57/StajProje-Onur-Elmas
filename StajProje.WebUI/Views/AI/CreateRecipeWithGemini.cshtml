@{
    ViewData["Title"] = "AI Şef - Akıllı Tarif Asistanı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="section">
    <div class="section-body">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-danger text-white">
                        <h4><i class="fas fa-utensils me-2"></i> Yummy AI - Akıllı Tarif Asistanı</h4>
                    </div>
                    <div class="card-body">
                        <!-- Malzemeleri alıp AI Controller'a POST eden form -->
                        <form asp-controller="AI" asp-action="CreateRecipeWithGemini" method="post">
                            <div class="form-group mb-3">
                                <label for="prompt" class="form-label fw-bold">Elindeki Malzemeleri Yaz:</label>
                                <textarea name="prompt" class="form-control" rows="4" placeholder="Örn: Tavuk göğsü, mantar, krema, sarımsak..." required></textarea>
                            </div>
                            <div class="text-center">
                                <button type="submit" class="btn btn-danger px-5 py-2 fw-bold rounded-pill">
                                    <i class="fas fa-magic me-1"></i> Tarif Önerisi Oluştur
                                </button>
                            </div>
                        </form>

                        <!-- Eğer AI'dan tarif döndüyse bu kutu görünecek -->
                        @if (ViewBag.recipe != null)
                        {
                            <div class="mt-4 p-4 border rounded bg-light">
                                <h5 class="text-danger fw-bold mb-3"><i class="fas fa-hat-chef me-2"></i> Şefin Önerisi:</h5>
                                <div style="white-space: pre-line; line-height: 1.6; color: #333;">
                                    @ViewBag.recipe
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>