@model GetByIdChefDto

@{
    ViewData["Title"] = "UpdateChef";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Şef Güncelleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <input type="hidden" asp-for="ChefId" />
                            <div class="form-group">
                                <label asp-for="NameSurname">Şef İsim Soyisim</label>
                                <input type="text" asp-for="NameSurname" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Title">Şef Ünvanı</label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label asp-for="Description">Şef Açıklaması</label>
                                <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Şef Resmi</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" />
                            </div>
                            <button class="btn btn-success">Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>