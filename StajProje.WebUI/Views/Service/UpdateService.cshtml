@model GetServiceByIdDto

@{
    ViewData["Title"] = "UpdateService";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Neden Biz? Güncelleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <input type="hidden" asp-for="ServiceId" />
                            <div class="form-group">
                                <label asp-for="Title">Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Açıklama</label>
                                <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                            </div>
                            <div class="form-group">
                                <label asp-for="IconUrl">İkon URL</label>
                                <input type="text" asp-for="IconUrl" class="form-control" />
                            </div>
                            <button class="btn btn-success">Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>