@model CreateProductDto

@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Ürün Ekleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <label asp-for="ProductName">Ürün Adı</label>
                                <input type="text" asp-for="ProductName" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="ProductPrice">Ürün Fiyatı</label>
                                <input type="number" asp-for="ProductPrice" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="ProductDescription">Ürün Açıklaması</label>
                                <textarea asp-for="ProductDescription" rows="5" class="form-control"></textarea>
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Ürün Resmi</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="CategoryId">Ürün Kategorisi</label>
                                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryItems">
                                    <option value="">Kategori Seçin</option>
                                </select>
                            </div>
                            <button class="btn btn-primary">Ekle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>