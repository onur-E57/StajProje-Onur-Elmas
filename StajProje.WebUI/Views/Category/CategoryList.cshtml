@model List<ResultCategoryDto>
@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Kategori Listesi</h4>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Kategori Adı</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.CategoryName</td>
                                        <td>Aktif</td>
                                        <td>
                                            <a href="/Category/DeleteCategory/@item.CategoryId" class="btn btn-danger btn-sm">Sil</a>
                                            <a href="/Category/UpdateCategory/@item.CategoryId" class="btn btn-warning btn-sm">Güncelle</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/Category/CreateCategory" class="btn btn-info btn-sm">+ Yeni Kategori</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@if (TempData["SuccessMessage"] != null)
{
    <!-- SweetAlert2 kütüphanesini anında projeye dahil ediyoruz -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        Swal.fire({
            title: 'Başarılı!',
            text: '@Html.Raw(TempData["SuccessMessage"])',
            icon: 'success',
            confirmButtonText: 'Tamam',
            timer: 2500,
            timerProgressBar: true
        });
    </script>
} 