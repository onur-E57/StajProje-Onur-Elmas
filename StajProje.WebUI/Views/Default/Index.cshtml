@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_HeadDefaultComponentPartial")

<body class="index-page">

    @await Component.InvokeAsync("_NavbarDefaultComponentPartial")

    <main class="main">

        <!-- Hero Section -->
        @await Component.InvokeAsync("_FeatureDefaultComponentPartial")
        <!-- /Hero Section -->
        <!-- About Section -->
        @await Component.InvokeAsync("_AboutDefaultComponentPartial")
        <!-- /About Section

        <!-- Why Us Section -->
        @await Component.InvokeAsync("_ServiceDefaultComponentPartial")
        <!-- /Why Us Section -->
        <!-- Stats Section -->
        <section id="stats" class="stats section dark-background">

            <img src="/yummy-red-1.0.0/assets/img/stats-bg.jpg" alt="" data-aos="fade-in">

            <div class="container position-relative" data-aos="fade-up" data-aos-delay="100">

                <div class="row gy-4">

                    <div class="col-lg-3 col-md-6">
                        <div class="stats-item text-center w-100 h-100">
                            <span data-purecounter-start="0" data-purecounter-end="232" data-purecounter-duration="1" class="purecounter"></span>
                            <p>Clients</p>
                        </div>
                    </div><!-- End Stats Item -->

                    <div class="col-lg-3 col-md-6">
                        <div class="stats-item text-center w-100 h-100">
                            <span data-purecounter-start="0" data-purecounter-end="521" data-purecounter-duration="1" class="purecounter"></span>
                            <p>Projects</p>
                        </div>
                    </div><!-- End Stats Item -->

                    <div class="col-lg-3 col-md-6">
                        <div class="stats-item text-center w-100 h-100">
                            <span data-purecounter-start="0" data-purecounter-end="1453" data-purecounter-duration="1" class="purecounter"></span>
                            <p>Hours Of Support</p>
                        </div>
                    </div><!-- End Stats Item -->

                    <div class="col-lg-3 col-md-6">
                        <div class="stats-item text-center w-100 h-100">
                            <span data-purecounter-start="0" data-purecounter-end="32" data-purecounter-duration="1" class="purecounter"></span>
                            <p>Workers</p>
                        </div>
                    </div><!-- End Stats Item -->

                </div>

            </div>

        </section>
        <!-- /Stats Section -->
        <!-- Menu Section -->
        @await Component.InvokeAsync("_DefaultMenuViewComponentPartial")
        <!-- /Menu Section -->
        <!-- Testimonials Section -->
        @await Component.InvokeAsync("_TestimonialDefaultComponentPartial")
        <!-- /Testimonials Section -->
        <!-- Events Section -->
        @await Component.InvokeAsync("_YummyEventDefaultComponentPartial")
        <!-- /Events Section -->

        <!-- Chefs Section -->
        @await Component.InvokeAsync("_ChefDefaultComponentPartial")
        <!-- /Chefs Section -->

        <!-- Book A Table Section -->
        @await Component.InvokeAsync("_ReservationDefaultComponentPartial")
        <!-- /Book A Table Section -->
        <!-- Gallery Section -->
        @await Component.InvokeAsync("_ImageDefaultComponentPartial")
        <!-- /Gallery Section -->
        <!-- Contact Section -->
        @await Component.InvokeAsync("_ContactDefaultComponentPartial")
        <!-- /Contact Section -->
    </main>

    @await Component.InvokeAsync("_FooterDefaultComponentPartial")

    <!-- SweetAlert2 kütüphanesi yüklü değilse -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
            function openAiChefModal() {
                Swal.fire({
                    title: '🤖 Yummy AI Şef',
                    text: 'Dolabında ne var? Malzemelerini yaz, şefimiz sana özel bir tarif hazırlasın!',
                    input: 'textarea',
                    inputPlaceholder: 'Örn: 2 yumurta, biraz kaşar, domates, bayat ekmek...',
                    showCancelButton: true,
                    confirmButtonText: 'Tarif Oluştur 🍳',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#ce1212',
                    showLoaderOnConfirm: true,
                    preConfirm: (promptText) => {
                        if (!promptText || promptText.trim() === '') {
                            Swal.showValidationMessage('Lütfen en az bir veya iki malzeme yazın!');
                            return false;
                        }

                        return fetch('/AI/CreateRecipeWithGemini', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ prompt: promptText })
                        })
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error(response.statusText);
                                }
                                return response.json();
                            })
                            .catch(error => {
                                Swal.showValidationMessage(`İstek başarısız oldu: ${error}`);
                            });
                    },
                    allowOutsideClick: () => !Swal.isLoading()
                }).then((result) => {
                    if (result.isConfirmed) {
                        if (result.value.success) {
                            Swal.fire({
                                title: '👨‍🍳 Şefin Sana Özel Tarifi',
                                html: `<div style="text-align: left; max-height: 400px; overflow-y: auto; white-space: pre-line; padding: 10px; background: #fdfdfd; border-radius: 8px; font-size: 14px; line-height: 1.6;">${result.value.recipe}</div>`,
                                icon: 'success',
                                confirmButtonText: 'Harika, Teşekkürler!',
                                confirmButtonColor: '#ce1212',
                                width: '650px'
                            });
                        } else {
                            Swal.fire('Hata', result.value.message, 'error');
                        }
                    }
                });
            }
    </script>

</body>

</html>