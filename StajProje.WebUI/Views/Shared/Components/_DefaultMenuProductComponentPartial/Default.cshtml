@model List<ResultProductDto>

<style>
    /* Bütün resimleri hizaya sokan o sihirli ayar */
    .menu-item .menu-img {
        width: 100%;
        height: 250px; /* Gözüne küçük/büyük gelirse buradaki rakamı değiştirebilirsin */
        object-fit: cover; /* Resmi bozmadan çerçeveye tam oturtur */
        border-radius: 10px; /* Kenarlara hafif yumuşaklık katar, Yummy temasına çok yakışır */
    }
</style>

<div class="tab-content" data-aos="fade-up" data-aos-delay="200">
    <div class="tab-pane fade active show" id="menu-starters">

        <div class="tab-header text-center">
            <p>Menü</p>
            <h3>Tüm Lezzetler</h3>
        </div>

        <div class="row gy-5">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 menu-item">
                    <a href="@item.ImageUrl" class="glightbox">
                        <img src="@item.ImageUrl" class="menu-img img-fluid" alt="">
                    </a>
                    <h4>@item.ProductName</h4>
                    <p class="ingredients">
                        @item.ProductDescription
                    </p>
                    <p class="price">
                        @item.ProductPrice ₺
                    </p>
                </div><!-- Menu Item -->
            }
        </div>
    </div>
</div>